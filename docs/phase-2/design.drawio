  <diagram name="03 / Backend class diagram" id="03-classes">
    <mxGraphModel pageWidth="1600" pageHeight="1320" page="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" value="03 / Backend class diagram" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry y="20" width="1530" as="geometry" height="40" x="35" />
        </mxCell>
        <mxCell id="n3" value="Complaint and Feedback Management System | Phase 2 review baseline | 27 November 2026" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=13;" vertex="1" parent="1">
          <mxGeometry y="65" width="1530" as="geometry" height="30" x="35" />
        </mxCell>
        <mxCell id="n4" value="User&#xA;--------------------------------------&#xA;+ Id: string&#xA;+ Username: string&#xA;+ PasswordHash: string&#xA;+ Role: UserRole" style="html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#3F4B5A;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry y="130" width="370" as="geometry" height="200" x="40" />
        </mxCell>
        <mxCell id="n5" value="Complaint&#xA;--------------------------------------&#xA;+ ReferenceNumber: string&#xA;+ SubmittedBy: string&#xA;+ Title: string&#xA;+ Category: ComplaintCategory&#xA;+ Description: string&#xA;+ Status: ComplaintStatus&#xA;+ AgentNotes: string&#xA;+ CreatedAt: DateTime&#xA;+ UpdatedAt: DateTime" style="html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#3F4B5A;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry y="420" width="370" as="geometry" height="310" x="40" />
        </mxCell>
        <mxCell id="n6" value="ComplaintService&#xA;-------------------------------------------------------------------&#xA;- _storage: StorageService&#xA;- _complaints: List&lt;Complaint&gt;&#xA;- _users: List&lt;User&gt;&#xA;+ ComplaintService(storage: StorageService? = null)&#xA;+ Authenticate(username: string, password: string): User?&#xA;+ SubmitComplaint(username: string, title: string,&#xA;    category: ComplaintCategory, description: string): Complaint&#xA;+ TrackByReference(referenceNumber: string): Complaint?&#xA;+ GetAllComplaints(categoryFilter: ComplaintCategory? = null,&#xA;    statusFilter: ComplaintStatus? = null): List&lt;Complaint&gt;&#xA;+ UpdateComplaintStatus(referenceNumber: string,&#xA;    newStatus: ComplaintStatus, newCategory: ComplaintCategory,&#xA;    agentNotes: string): bool" style="html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#3F4B5A;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry y="130" width="980" as="geometry" height="390" x="510" />
        </mxCell>
        <mxCell id="n7" value="StorageService&#xA;-------------------------------------------------------------------&#xA;- _directory: string / _gate: object&#xA;+ StorageService(dataDirectory: string? = null)&#xA;+ LoadComplaints(): List&lt;Complaint&gt; {virtual}&#xA;+ SaveComplaints(complaints: List&lt;Complaint&gt;): void {virtual}&#xA;+ LoadUsers(): List&lt;User&gt; {virtual}&#xA;+ SaveUsers(users: List&lt;User&gt;): void {virtual}&#xA;+ RestoreComplaintsBackup(): bool&#xA;+ RestoreUsersBackup(): bool&#xA;+ HashPassword(password: string): string {static}&#xA;~ ReserveReference(complaints: IReadOnlyCollection&lt;Complaint&gt;, year: int): string&#xA;~ WithComplaintLock&lt;T&gt;(operation: Func&lt;T&gt;): T" style="html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#3F4B5A;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry y="650" width="850" as="geometry" height="350" x="620" />
