            <mxPoint x="600" y="650" as="sourcePoint" />
            <mxPoint x="600" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n10" value="LOCAL RECORDS&#xA;complaints.json / users.json (process working directory)" style="html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#3F4B5A;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
