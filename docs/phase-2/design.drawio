            <mxPoint x="600" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n8" value="DATA ACCESS &amp; DOMAIN | Data/ and Models/&#xA;StorageService / User / Complaint / Enums&#xA;JSON serialization and deserialization; SHA-256 password hashing" style="html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#3F4B5A;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
