            <mxPoint x="600" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n6" value="BUSINESS LOGIC | Services/ComplaintService&#xA;Authenticate; validate title and description; generate references&#xA;Submit and track complaints; filter category/status; update category/status/notes" style="html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#3F4B5A;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry y="330" width="860" as="geometry" height="130" x="170" />
        </mxCell>
        <mxCell id="n7" edge="1" parent="1" style="endArrow=open;dashed=0;html=0;strokeColor=#3F4B5A;">
