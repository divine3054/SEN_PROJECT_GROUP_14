        </mxCell>
        <mxCell id="n5" value="Complaint&#xA;--------------------------------------&#xA;+ ReferenceNumber: string&#xA;+ SubmittedBy: string&#xA;+ Title: string&#xA;+ Category: ComplaintCategory&#xA;+ Description: string&#xA;+ Status: ComplaintStatus&#xA;+ AgentNotes: string&#xA;+ CreatedAt: DateTime&#xA;+ UpdatedAt: DateTime" style="html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#3F4B5A;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
          <mxGeometry y="420" width="370" as="geometry" height="310" x="40" />
        </mxCell>
        <mxCell id="n6" value="ComplaintService&#xA;-------------------------------------------------------------------&#xA;- _storage: StorageService&#xA;- _complaints: List&lt;Complaint&gt;&#xA;- _users: List&lt;User&gt;&#xA;+ ComplaintService()&#xA;+ Authenticate(username: string, password: string): User?&#xA;+ SubmitComplaint(username: string, title: string,&#xA;    category: ComplaintCategory, description: string): Complaint&#xA;+ TrackByReference(referenceNumber: string): Complaint?&#xA;+ GetAllComplaints(categoryFilter: ComplaintCategory? = null,&#xA;    statusFilter: ComplaintStatus? = null): List&lt;Complaint&gt;&#xA;+ UpdateComplaintStatus(referenceNumber: string,&#xA;    newStatus: ComplaintStatus, newCategory: ComplaintCategory,&#xA;    agentNotes: string): bool" style="html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#3F4B5A;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
