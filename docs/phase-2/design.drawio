        <mxCell id="n4" value="User&#xA;--------------------------------------&#xA;+ Id: string&#xA;+ Username: string&#xA;+ PasswordHash: string&#xA;+ Role: UserRole" style="html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#3F4B5A;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
