        <mxCell id="n7" value="StorageService&#xA;-------------------------------------------------------------------&#xA;- _complaintsFile: string&#xA;- _usersFile: string&#xA;+ LoadComplaints(): List&lt;Complaint&gt;&#xA;+ SaveComplaints(complaints: List&lt;Complaint&gt;): void&#xA;+ LoadUsers(): List&lt;User&gt;&#xA;+ SaveUsers(users: List&lt;User&gt;): void&#xA;+ HashPassword(password: string): string {static}" style="html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#3F4B5A;fontFamily=Arial;fontSize=15;" vertex="1" parent="1">
